{
  "name": "dealflow360",
  "version": "1.0.0",
  "description": "Intelligent B2B Sales Operations & Deal Governance Platform",
  "main": "server/dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "ts-node-dev --respawn --transpile-only server/src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "prisma generate && tsc -p tsconfig.json && npm --prefix client run build",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "db:populate": "ts-node prisma/generate_mock_data.ts",
    "db:reset": "prisma db push --force-reset && ts-node prisma/seed.ts",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.1.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
